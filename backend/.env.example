# ---------------------------------------------------------------------------
# Q-Key backend environment configuration
# Copy this file to ".env" and fill in the values you need.
# Never commit the real ".env" file.
# ---------------------------------------------------------------------------

# QRNG provider. "anu" = ANU Quantum Random Numbers Server (public, no key
# required for light usage). This is an EXTERNAL physical entropy source -
# the backend itself does not contain quantum hardware.
QRNG_PROVIDER=anu
QRNG_API_URL=
QRNG_API_KEY=
QRNG_TIMEOUT_SECONDS=6.0

# If the external QRNG is unreachable, allow the system to fall back to the
# OS-level CSPRNG (Python "secrets" module) instead of failing the request.
# Every fallback event is written to the audit log and clearly labeled.
ALLOW_CSPRNG_FALLBACK=true

# DEMO_MODE relaxes key-secrecy rules ONLY for hackathon demonstration
# purposes (e.g. showing a masked preview of generated key material).
# Set to false for anything resembling a production deployment.
DEMO_MODE=true

DATABASE_URL=

CORS_ORIGINS=

DEFAULT_KEY_EXPIRY_DAYS=30
